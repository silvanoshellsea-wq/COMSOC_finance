{
  "name": "comsoc-finance",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "npm run build && vite preview",
    "build:hosted": "tsc -b && node scripts/build-hosted.mjs",
    "deploy": "npm run build:hosted && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "setup:local": "node scripts/setup-local.mjs",
    "test": "npm run build && node --test tests/finance.test.mjs tests/statements.test.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "miniflare": "5.20261117.0-beta",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.166.0"
  }
}
