{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "comsoc-finance",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-19",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "comsoc-finance",
      // Local placeholder. Replace with the hosted D1 database ID before deploying.
      "database_id": "00000000-0000-4000-8000-000000000001"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RECEIPTS",
      "bucket_name": "comsoc-finance-receipts"
    }
  ]
}
